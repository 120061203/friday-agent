ANTHROPIC_API_KEY=sk-ant-請填入你的金鑰
ANTHROPIC_MODEL=claude-sonnet-5
RATE_LIMIT_PER_MINUTE=10
AGENT_MAX_ROUNDS=10

# 控制 adaptive thinking 的思考量（thinking tokens 算 output，單價是 input 的 5 倍）。
# 可選 low/medium/high/xhigh/max，不設定則預設 medium。
AGENT_EFFORT=medium

# 以下皆為選填：設定 LITELLM_BASE_URL 後，會優先透過 LiteLLM 呼叫，
# 只有在連線 LiteLLM 失敗時才 fallback 回上面的官方 ANTHROPIC_API_KEY。
# 不設定 LITELLM_BASE_URL 時，行為與原本完全一樣（只打官方 API）。
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# 選填：設定後 web_search 會改用 Brave Search API（比預設的 ddgs/DuckDuckGo 穩定）。
# 不設定則自動退回 ddgs，不需要 API key。
BRAVE_API_KEY=
